# Hedera testnet account that will own/issue the ATS assets (Hedera id form, e.g. 0.0.xxxxxx)
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_PRIVATE_KEY=

# Network endpoints (defaults shown are Hedera testnet)
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1/
RPC_NODE_URL=https://testnet.hashio.io/api

# ATS testnet deployment coordinates. The SDK README's addresses
# (Resolver 0.0.6797832 / Factory 0.0.6797955) are STALE — confirmed dead
# in the Phase 0 spike (docs/phase-0-findings.md). These are the addresses
# confirmed live as of 2026-09-07, from
# hashgraph/asset-tokenization-studio's packages/ats/contracts/deployments/hedera-testnet/
# (latest file there at time of writing: newBlr-2026-06-12T11-19-42-198.json).
# Re-check that directory for anything newer before relying on these.
ATS_RESOLVER_EVM_ADDRESS=0xBA2D5FC2083A0b8f164c50e65d782087fBA18E0a
ATS_FACTORY_EVM_ADDRESS=0xd1F118A40f3b02883D35909eF2517e7EDd78379d

# EVM addresses that must be granted "Control list Role" + added to each
# asset's control list before they can hold/move it. Fill in after
# deploying the corresponding contracts (Phase 2/3):
PROTOCOL_ADDRESS_ATOKEN_GOLD=
PROTOCOL_ADDRESS_ATOKEN_STOCK=
PROTOCOL_ADDRESS_VAULT=
PROTOCOL_ADDRESS_LIQUIDATOR_DEMO=
