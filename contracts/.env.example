# Hedera testnet RPC (HashIO JSON-RPC relay). Default works without an account.
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api

# ECDSA private key (hex, no 0x needed either way) of a funded Hedera testnet
# account. Get one from https://portal.hedera.com/ (testnet faucet).
HEDERA_TESTNET_OPERATOR_PRIVATE_KEY=

# Pyth on Hedera testnet — confirmed live in the Phase 0 spike (see
# docs/phase-0-findings.md). No live equity/stock-index feed exists at all
# (PriceFeedNotFound) — STOCK_INDEX is deliberately a crypto feed (ETH/USD)
# substituted per PLAN.md §6.1, not a real stock index.
PYTH_CONTRACT_ADDRESS=0xA2aa501b19aff244D90cc15a4Cf739D2725B5729
PYTH_FEED_ID_XAU_USD=0x765d2ba906dbc32ca17cc11f5310a89e9ee1f6420508c63861f2f8ba4ee34bb2
PYTH_FEED_ID_STOCK_INDEX=0xff61491a931112ddf1bd8147cd1b641375f79f5825126d665480874634fd0ace
PYTH_FEED_ID_USDC_USD=0xeaa020c61cc479712813461ce153894a96a6c00b21ed0cfc2798d1f9a9e9c94a

# Required to push fresh price updates (contracts/script/update-oracle-prices.ts)
# since Hermes started requiring a key on 2026-08-26 — free trial only,
# paid plans cover ongoing use. See docs/phase-2-findings.md for the cost
# model and a known Hedera-testnet compatibility issue (InvalidWormholeVaa)
# found while using this. Get one: sign up at https://pythdata.app, then
# "🔑 View your API key".
PYTH_HERMES_API_KEY=
